<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page" name="Villa Marianne page">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="page['title']"/>
            <t t-set="website_meta_description" t-value="page['meta']"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <header class="hbm-header">
                <a class="hbm-brand" t-att-href="paths['home']" t-out="c['site']"/>
                <nav class="hbm-nav">
                    <t t-foreach="c['nav']" t-as="nav_key">
                        <a t-att-href="paths[nav_key]" t-att-class="'active' if nav_key == key else ''"
                           t-out="c['nav'][nav_key]"/>
                    </t>
                    <a class="hbm-switch" t-att-href="alt_path" t-out="c['switch']"/>
                </nav>
            </header>
            <main id="hbm-main" class="hbm-main">
                <section class="hbm-hero">
                    <h1 t-out="page['title'].split(' | ')[0]"/>
                    <p class="hbm-lead" t-out="page['lead']"/>
                    <t t-if="key == 'home'">
                        <p class="hbm-price">
                            <span t-out="c['price_label']"/> <strong t-out="prop.price_display()"/>
                        </p>
                    </t>
                    <p t-if="key != 'contact'" class="hbm-actions">
                        <a class="hbm-btn" t-att-href="paths['contact']" t-out="c['cta_brochure']"/>
                        <a class="hbm-btn hbm-btn-alt" t-att-href="paths['contact']" t-out="c['cta_visit']"/>
                    </p>
                </section>
                <section t-foreach="page['sections']" t-as="sec" class="hbm-section">
                    <h2 t-out="sec['h']"/>
                    <p t-foreach="sec['p']" t-as="para" t-out="para"/>
                    <ul t-if="sec['ul']">
                        <li t-foreach="sec['ul']" t-as="item" t-out="item"/>
                    </ul>
                </section>
                <img t-if="hero" class="hbm-hero-img" t-att-src="hero['src']" t-att-srcset="hero['srcset']"
                     sizes="(max-width: 960px) 100vw, 960px" t-att-width="hero['width']"
                     t-att-height="hero['height']" t-att-alt="hero['alt']" fetchpriority="high"/>
                <section t-if="gallery" class="hbm-section">
                    <h2 t-out="c['gallery_title']"/>
                    <t t-set="first_image" t-value="True"/>
                    <t t-foreach="c['spaces']" t-as="space_key">
                        <t t-set="space_items" t-value="[i for i in gallery if i['space'] == space_key]"/>
                        <h3 t-if="space_items" t-out="c['spaces'][space_key]"/>
                        <div t-if="space_items" class="hbm-gallery">
                            <t t-foreach="space_items" t-as="img">
                                <img class="hbm-gallery-img" t-att-src="img['src']" t-att-srcset="img['srcset']"
                                     sizes="(max-width: 640px) 100vw, 300px" t-att-width="img['width']"
                                     t-att-height="img['height']" t-att-alt="img['alt']"
                                     t-att-loading="None if first_image else 'lazy'"/>
                                <t t-set="first_image" t-value="False"/>
                            </t>
                        </div>
                    </t>
                </section>
                <section t-if="page.get('faq')" class="hbm-section">
                    <h2 t-out="c['faq_title']"/>
                    <t t-foreach="page['faq']" t-as="item">
                        <h3 t-out="item['q']"/>
                        <p t-out="item['a']"/>
                    </t>
                </section>
                <section t-if="key in ('home', 'villa')" class="hbm-section">
                    <h2 t-out="c['facts_title']"/>
                    <dl class="hbm-facts">
                        <t t-foreach="facts" t-as="fact">
                            <dt t-out="fact[1]"/>
                            <dd t-out="fact[2]"/>
                        </t>
                    </dl>
                </section>
            </main>
            <footer class="hbm-footer">
                <p t-out="c['footer']"/>
                <a t-att-href="paths['legal']" t-out="c['legal_link']"/>
            </footer>
        </t>
    </template>
</odoo>
