<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page" name="Villa Marianne page">
        <!-- Squelette léger (web.layout) : aucun JavaScript ni CSS du site Odoo, pour la vitesse -->
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'fr-FR' if c['lang'] == 'fr' else 'en-US'}"/>
            <t t-set="title" t-value="page['title']"/>
            <t t-set="x_icon" t-value="'/hbm_villa_sale/static/img/favicon.png'"/>
            <t t-set="body_classname" t-value="'hbm-body'"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="description" t-att-content="page['meta']"/>
                <link rel="canonical" t-att-href="canonical"/>
                <t t-if="alternates">
                    <link rel="alternate" hreflang="fr" t-att-href="alternates['fr']"/>
                    <link rel="alternate" hreflang="en" t-att-href="alternates['en']"/>
                    <link rel="alternate" hreflang="x-default" t-att-href="alternates['fr']"/>
                </t>
                <meta property="og:type" content="website"/>
                <meta property="og:title" t-att-content="hbm_seo['title']"/>
                <meta property="og:description" t-att-content="page['meta']"/>
                <meta property="og:image" t-att-content="hbm_seo['og_image']"/>
                <meta property="og:locale" t-att-content="hbm_seo['locale']"/>
                <meta property="og:url" t-att-content="hbm_seo['url']"/>
                <meta name="twitter:card" content="summary_large_image"/>
                <meta t-if="hbm_seo['noindex']" name="robots" content="noindex, nofollow"/>
                <link rel="stylesheet" href="/hbm_villa_sale/static/src/css/villa.css"/>
                <script type="application/ld+json" t-out="ld_json"/>
                <script defer="defer" src="/hbm_villa_sale/static/src/js/consent.js"/>
                <script defer="defer" src="/hbm_villa_sale/static/src/js/tracking.js"/>
            </t>
            <a class="hbm-skip" href="#hbm-main" t-out="c['skip']"/>
            <header class="hbm-header">
                <a class="hbm-brand" t-att-href="paths['home']" t-out="c['site']"/>
                <nav t-if="not landing" class="hbm-nav">
                    <t t-foreach="c['nav']" t-as="nav_key">
                        <a t-att-href="paths[nav_key]" t-att-class="'active' if nav_key == key or (key == 'article' and nav_key == 'blog') else ''"
                           t-out="c['nav'][nav_key]"/>
                    </t>
                    <a class="hbm-switch" t-att-href="alt_path" t-out="c['switch']"/>
                </nav>
            </header>
            <main id="hbm-main" class="hbm-main">
                <section class="hbm-hero">
                    <h1 t-out="page['title'].split(' | ')[0]"/>
                    <p class="hbm-lead" t-out="page['lead']"/>
                    <t t-if="key in ('home', 'landing')">
                        <p class="hbm-price">
                            <span t-out="c['price_label']"/> <strong t-out="prop.price_display()"/>
                            <small t-if="prop.price_negotiable" t-out="c['negotiable']"/>
                        </p>
                    </t>
                    <p t-if="equivalents" class="hbm-equivalents">
                        <t t-out="' · '.join(equivalents)"/> <small t-out="c['indicative']"/>
                    </p>
                    <p t-if="key != 'contact' and not landing" class="hbm-actions">
                        <a class="hbm-btn" t-att-href="paths['contact']" t-out="c['cta_brochure']"/>
                        <a class="hbm-btn hbm-btn-alt" t-att-href="paths['contact']" t-out="c['cta_visit']"/>
                    </p>
                    <img t-if="hero" class="hbm-hero-img" t-att-src="hero['src']" t-att-srcset="hero['srcset']"
                         sizes="(max-width: 960px) 100vw, 960px" t-att-width="hero['width']"
                         t-att-height="hero['height']" t-att-alt="hero['alt']" fetchpriority="high"/>
                </section>
                <section t-foreach="page['sections']" t-as="sec" class="hbm-section">
                    <h2 t-if="sec['h']" t-out="sec['h']"/>
                    <p t-foreach="sec['p']" t-as="para" t-out="para"/>
                    <ul t-if="sec['ul']">
                        <li t-foreach="sec['ul']" t-as="item" t-out="item"/>
                    </ul>
                </section>
                <section t-if="gallery" class="hbm-section">
                    <h2 t-out="c['gallery_title']"/>
                    <t t-set="first_image" t-value="True"/>
                    <t t-foreach="c['spaces']" t-as="space_key">
                        <t t-set="space_items" t-value="[i for i in gallery if i['space'] == space_key]"/>
                        <h3 t-if="space_items" t-out="c['spaces'][space_key]"/>
                        <div t-if="space_items" class="hbm-gallery">
                            <t t-foreach="space_items" t-as="img">
                                <img class="hbm-gallery-img" t-att-src="img['src']" t-att-srcset="img['srcset']"
                                     t-att-sizes="'(max-width: 960px) 100vw, 960px' if img['wide'] else '(max-width: 640px) 100vw, 300px'"
                                     t-att-width="img['width']"
                                     t-att-height="img['height']" t-att-alt="img['alt']"
                                     t-att-loading="None if first_image else 'lazy'"
                                     t-att-data-wide="'1' if img['wide'] else None"/>
                                <t t-set="first_image" t-value="False"/>
                            </t>
                        </div>
                    </t>
                </section>
                <section t-if="key == 'blog'" class="hbm-section">
                    <article t-foreach="c['articles']" t-as="art" class="hbm-article">
                        <h2><a t-att-href="'/conseils/' + art['slug']" t-out="art['title']"/></h2>
                        <p t-out="art['lead']"/>
                        <a t-att-href="'/conseils/' + art['slug']" t-out="c['read_more']"/>
                    </article>
                </section>
                <section t-if="article" class="hbm-section">
                    <a class="hbm-link" t-att-href="paths['villa']" t-out="c['article_cta']"/>
                </section>
                <section t-if="key in ('contact', 'landing')" class="hbm-section">
                    <t t-call="hbm_villa_sale.contact_form"/>
                </section>
                <section t-if="page.get('faq')" class="hbm-section">
                    <h2 t-out="c['faq_title']"/>
                    <t t-foreach="page['faq']" t-as="item">
                        <h3 t-out="item['q']"/>
                        <p t-out="item['a']"/>
                    </t>
                </section>
                <section t-if="key in ('home', 'villa')" class="hbm-section">
                    <h2 t-out="c['facts_title']"/>
                    <dl class="hbm-facts">
                        <t t-foreach="facts" t-as="fact">
                            <dt t-out="fact[1]"/>
                            <dd t-out="fact[2]"/>
                        </t>
                    </dl>
                </section>
            </main>
            <footer class="hbm-footer">
                <p t-out="c['footer']"/>
                <a t-att-href="paths['legal']" t-out="c['legal_link']"/>
                <a t-if="gtm_id" href="#" data-hbm-consent-reset="1" t-out="c['cookies_manage']"/>
                <a t-if="whatsapp_url" class="hbm-whatsapp" t-att-href="whatsapp_url" t-out="c['whatsapp']"/>
            </footer>
            <div t-if="gtm_id" id="hbm-consent" class="hbm-consent" t-att-data-gtm-id="gtm_id" hidden="hidden"
                 role="dialog" aria-live="polite">
                <p t-out="c['consent']['text']"/>
                <button type="button" class="hbm-btn" data-hbm-consent="granted" t-out="c['consent']['accept']"/>
                <button type="button" class="hbm-btn hbm-btn-alt" data-hbm-consent="denied" t-out="c['consent']['refuse']"/>
            </div>
        </t>
    </template>
</odoo>
