<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout_seo_head" inherit_id="website.layout" name="Villa Marianne SEO head">
        <xpath expr="//head" position="inside">
            <t t-if="hbm_seo">
                <meta property="og:type" content="website"/>
                <meta property="og:title" t-att-content="hbm_seo['title']"/>
                <meta property="og:description" t-att-content="website_meta_description"/>
                <meta property="og:image" t-att-content="hbm_seo['og_image']"/>
                <meta property="og:locale" t-att-content="hbm_seo['locale']"/>
                <meta property="og:url" t-att-content="hbm_seo['url']"/>
                <meta name="twitter:card" content="summary_large_image"/>
                <meta t-if="hbm_seo['noindex']" name="robots" content="noindex, nofollow"/>
                <script type="application/ld+json" t-out="ld_json"/>
            </t>
        </xpath>
    </template>
</odoo>
