<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.lang_fr" model="res.lang">
        <field name="active" eval="True"/>
    </record>
    <function model="website" name="write">
        <value eval="[ref('website.default_website')]"/>
        <value eval="{'name': 'Villa Marianne', 'configurator_done': True, 'language_ids': [(6, 0, [ref('base.lang_fr'), ref('base.lang_en')])], 'default_lang_id': ref('base.lang_fr')}"/>
    </function>
    <!-- l'assistant de configuration d'Odoo est inutile ici : les pages sont fournies par le module -->
    <function model="ir.actions.todo" name="write">
        <value eval="[ref('website.website_configurator_todo')]"/>
        <value eval="{'state': 'done'}"/>
    </function>
</odoo>
